
def vending_machine():
    while True:
        choice = input("Enter an item code (or q to quit): ").upper()

        if choice == "q".upper():
            print("Thank you for using the vending machine!")
            break
        elif choice == "B3":
            print("You got Nacho Chips!")
        elif choice == "G4":
            print("You got BBQ Chips!")
        elif choice == "G7":
            print("You got Plain Chips!")
        elif choice == "D3":
            print("You got Water!")
        elif choice == "G5":
            print("You got Cola Soda!")
        else:
            print("Invalid code. Please try again.")

vending_machine()
